<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_unified_tags" model="ir.ui.view">
        <field name="name">res.company.form.unified.tags</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="unified_tags"/>
                <field name="contact_salesperson_sync"/>
            </xpath>
        </field>
    </record>
</odoo>
